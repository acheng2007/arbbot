ARBBOT_DATABASE_URL=postgresql+psycopg://arbbot:arbbot@localhost:55432/arbbot
ARBBOT_MODE=simulation
ARBBOT_POLL_SECONDS=5
ARBBOT_POLYMARKET_WEBSOCKET=true
ARBBOT_DISCOVERY_LIMIT=50
ARBBOT_MAX_QUOTE_AGE_SECONDS=30
ARBBOT_MAX_QUOTE_SKEW_SECONDS=10
ARBBOT_MAX_CONTRACTS=1000
ARBBOT_MAX_CAPITAL=1000
ARBBOT_SLIPPAGE_BPS=10
ARBBOT_MIN_PROFIT=0.01
ARBBOT_CORS_ORIGINS=["http://localhost:3000"]
# For live mode, configure locally or inject secrets into the worker container.
# ARBBOT_KALSHI_KEY_ID=your-key-id
# ARBBOT_KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/private-key.pem
# ARBBOT_REVIEWS_FILE=/absolute/path/to/reviews.json
# Optional explicit watchlists replace broad discovery for each venue.
# ARBBOT_KALSHI_TICKERS=["EXACT-MARKET-TICKER"]
# ARBBOT_POLYMARKET_MARKET_IDS=["123456"]
# Evidence-backed interpretations required before live pair approval.
# ARBBOT_DEFINITIONS_FILE=/absolute/path/to/definitions.json
