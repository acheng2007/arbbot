      "id": "609655",
      "question": "US recession by end of 2026?",
      "conditionId": "0xfdc73f10edf0266756686f35b5712cffa828b0940fc015e0426c76c934c2105d",
      "slug": "us-recession-by-end-of-2026",
      "resolutionSource": "",
      "endDate": "2027-01-31T00:00:00Z",
