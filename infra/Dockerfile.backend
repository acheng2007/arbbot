FROM python:3.14-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    ARBBOT_EMBEDDING_CACHE=/opt/arbbot-models ARBBOT_EMBEDDING_LOCAL_ONLY=true
WORKDIR /app
COPY backend/requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir -r requirements.lock
COPY backend /app
RUN pip install --no-cache-dir --no-deps . && useradd --create-home arbbot
RUN ARBBOT_EMBEDDING_LOCAL_ONLY=false python -m arbbot.matching.retrieval \
    && chown -R arbbot:arbbot /opt/arbbot-models
USER arbbot
EXPOSE 8000
CMD ["uvicorn", "arbbot.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
