  "components": {
    "schemas": {
      "Book": {
        "properties": {
          "market_id": {
            "type": "string",
            "title": "Market Id"
          },
          "mode": {
            "type": "string",
            "enum": [
              "simulation",
              "live"
            ],
            "title": "Mode"
          },
          "yes_asks": {
            "items": {
              "$ref": "#/components/schemas/Level"
            },
            "type": "array",
            "title": "Yes Asks"
          },
          "no_asks": {
            "items": {
              "$ref": "#/components/schemas/Level"
            },
            "type": "array",
            "title": "No Asks"
          },
          "min_order_size": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Min Order Size",
            "default": "1"
          },
          "source_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source At"
          },
          "received_at": {
            "type": "string",
            "format": "date-time",
            "title": "Received At"
          },
          "raw": {
            "additionalProperties": true,
            "type": "object",
            "title": "Raw"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "market_id",
          "mode",
          "yes_asks",
          "no_asks",
          "received_at",
          "raw"
        ],
        "title": "Book"
      },
      "CostPolicy": {
        "properties": {
          "fee_per_contract": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Fee Per Contract"
          },
          "fixed_fee": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Fixed Fee"
          },
          "min_order_size": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Min Order Size"
          },
          "min_notional": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Min Notional"
          },
          "cost_fx": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Cost Fx"
          },
          "payout_fx": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Payout Fx"
          },
          "evidence": {
            "type": "string",
            "minLength": 10,
            "title": "Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "fee_per_contract",
          "fixed_fee",
          "min_order_size",
          "min_notional",
          "cost_fx",
          "payout_fx",
          "evidence"
        ],
        "title": "CostPolicy"
      },
      "Evaluation": {
        "properties": {
          "match_id": {
            "type": "string",
            "title": "Match Id"
          },
          "mode": {
            "type": "string",
            "enum": [
              "simulation",
              "live"
            ],
            "title": "Mode"
          },
          "evaluated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Evaluated At"
          },
          "blocked_reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Blocked Reasons"
          },
          "opportunities": {
            "items": {
              "$ref": "#/components/schemas/Opportunity"
            },
            "type": "array",
            "title": "Opportunities"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "match_id",
          "mode",
          "evaluated_at",
          "blocked_reasons",
          "opportunities"
        ],
        "title": "Evaluation"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Leg": {
        "properties": {
          "market_id": {
            "type": "string",
            "title": "Market Id"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "yes",
              "no"
            ],
            "title": "Outcome"
          },
          "quantity": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Quantity"
          },
          "limit_price": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Limit Price"
          },
          "book_id": {
            "type": "string",
            "title": "Book Id"
          },
          "quote_at": {
            "type": "string",
            "format": "date-time",
            "title": "Quote At"
          },
          "source_timestamp_available": {
            "type": "boolean",
            "title": "Source Timestamp Available"
          },
          "native_cost": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Native Cost"
          },
          "cost_usd": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Cost Usd"
          },
          "fee_bound_usd": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Fee Bound Usd"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "market_id",
          "outcome",
          "quantity",
          "limit_price",
          "book_id",
          "quote_at",
          "source_timestamp_available",
          "native_cost",
          "cost_usd",
          "fee_bound_usd"
        ],
        "title": "Leg"
      },
      "Level": {
        "properties": {
          "price": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Price"
          },
          "size": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
