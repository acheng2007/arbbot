      },
      "Market": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "venue": {
            "type": "string",
            "enum": [
              "kalshi",
              "polymarket"
            ],
            "title": "Venue"
          },
          "external_id": {
            "type": "string",
            "title": "External Id"
          },
          "mode": {
            "type": "string",
            "enum": [
              "simulation",
              "live"
            ],
            "title": "Mode"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "rules": {
            "type": "string",
            "title": "Rules"
          },
          "closes_at": {
            "type": "string",
            "format": "date-time",
            "title": "Closes At"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "closed"
            ],
            "title": "Status"
          },
          "settlement_asset": {
            "type": "string",
            "title": "Settlement Asset"
          },
          "tokens": {
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "enum": [
                "yes",
                "no"
              ]
            },
            "type": "object",
            "title": "Tokens",
            "default": {}
          },
          "settlement_details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Settlement Details",
            "default": {}
          },
          "raw": {
            "additionalProperties": true,
            "type": "object",
            "title": "Raw"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Observed At"
          },
          "terms_hash": {
            "type": "string",
            "title": "Terms Hash",
            "readOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "venue",
          "external_id",
          "mode",
          "title",
          "rules",
          "closes_at",
          "status",
          "settlement_asset",
          "raw",
          "observed_at",
          "terms_hash"
        ],
        "title": "Market"
      },
      "Match": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "mode": {
            "type": "string",
            "enum": [
              "simulation",
              "live"
            ],
            "title": "Mode"
          },
          "left_id": {
            "type": "string",
            "title": "Left Id"
          },
          "right_id": {
            "type": "string",
            "title": "Right Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "candidate",
