{
  "$defs": {
    "ContractDefinition": {
      "additionalProperties": false,
      "properties": {
        "market_id": {
          "title": "Market Id",
          "type": "string"
        },
        "terms_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Terms Hash",
          "type": "string"
        },
        "extractor": {
          "minLength": 1,
          "title": "Extractor",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "enum": [
            1,
            2
          ],
          "title": "Schema Version",
          "type": "integer"
        },
        "facts": {
          "additionalProperties": {
            "$ref": "#/$defs/Fact"
          },
          "propertyNames": {
            "enum": [
              "event_type",
              "entity",
              "metric",
              "reference_period",
              "measurement",
              "source",
              "value_version",
              "operator",
              "threshold",
              "units",
              "observation_window",
              "timezone",
              "outcome_orientation",
              "payout",
              "cancellation",
              "exceptions",
              "seasonal_adjustment",
              "rounding_increment",
              "rounding_mode",
              "revision_policy",
              "observation_start",
              "observation_end",
              "observation_start_inclusive",
              "observation_end_inclusive"
            ]
          },
          "title": "Facts",
          "type": "object"
        },
        "settlement_policies": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SettlementPolicy"
              },
              "maxItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settlement Policies"
        }
      },
      "required": [
        "market_id",
        "terms_hash",
        "extractor",
        "facts"
      ],
      "title": "ContractDefinition",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "source": {
          "enum": [
            "title",
            "rules",
            "settlement_details"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Key"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "value",
        "source",
        "quote"
      ],
      "title": "Fact",
      "type": "object"
    },
    "SettlementCondition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "trigger": {
          "maxLength": 2000,
          "minLength": 10,
          "title": "Trigger",
          "type": "string"
        },
        "yes_payout": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Yes Payout"
        },
        "no_payout": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "No Payout"
        }
      },
      "required": [
        "id",
        "trigger",
        "yes_payout",
        "no_payout"
      ],
      "title": "SettlementCondition",
      "type": "object"
    },
    "SettlementPolicy": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "cancellation",
            "fallback",
            "ambiguous_resolution"
          ],
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "modeled",
            "not_applicable",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Fact"
        },
        "conditions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SettlementCondition"
          },
          "maxItems": 32,
          "title": "Conditions",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "status",
        "evidence"
      ],
      "title": "SettlementPolicy",
      "type": "object"
    }
  },
  "items": {
    "$ref": "#/$defs/ContractDefinition"
  },
  "type": "array"
}
